PORT=3000
MONGO_URI=mongodb://localhost:27027/shipflow
REDIS_HOST=localhost
REDIS_PORT=6389
# Managed Redis only (Azure Managed Redis: port 10000, access key as password, TLS on)
# REDIS_PASSWORD=
# REDIS_TLS=true
# all     — everything in one process (local development)
# api     — control plane + runtime gateway (HTTP), no queue workers
# runtime — runtime gateway only (/api/run/*, /api/health): the data plane your apps call
# worker  — queue workers only (async workflow steps, domain events → workflow runs, schedules)
APP_ROLE=all
# When set, courier webhooks must carry x-shipflow-signature = HMAC-SHA256(body, secret)
WEBHOOK_SECRET=

# Allow workflow HTTP / Fetch data steps to call localhost and private IPs (dev only; cloud metadata stays blocked)
HTTP_ALLOW_PRIVATE_NETWORKS=false

# --- Scaling -------------------------------------------------------------------------------------
# Steps one worker process runs at once (I/O-bound workflows can go higher, e.g. 20–50).
WORKER_CONCURRENCY=10
# Domain events one worker turns into workflow runs at once.
EVENT_CONCURRENCY=20
# Threads for user code (Run code, custom nodes). Default: CPU cores - 1, at most 4. 0 = main thread.
# SANDBOX_THREADS=4
# Days of run history to keep (MongoDB deletes older runs automatically).
EXECUTION_RETENTION_API_DAYS=7
EXECUTION_RETENTION_DAYS=30

# --- Limits and fairness -------------------------------------------------------------------------
# Request body size (KB) for every HTTP call; larger ones get 413.
MAX_REQUEST_BODY_KB=1024
# Set to true behind a load balancer so per-IP limits use X-Forwarded-For.
TRUST_PROXY=false
# Runtime gateway limits, calls per minute (0 = off). Counted in Redis across all replicas.
RATE_LIMIT_TENANT_PER_MINUTE=6000
RATE_LIMIT_API_KEY_PER_MINUTE=1200
RATE_LIMIT_IP_PER_MINUTE=300
# Synchronous endpoint calls one tenant may have running at once (more get 429).
TENANT_MAX_CONCURRENT_SYNC=50
# Workflow steps one tenant may have running at once across all workers (0 = no cap).
TENANT_MAX_ACTIVE_STEPS=20

# --- Accounts and access -------------------------------------------------------------------------
# Anyone may sign up and get a workspace (false: owners add people under Members).
ALLOW_SIGNUP=true
# Comma-separated emails that may change platform-wide settings (couriers) and read /api/health/load.
PLATFORM_ADMIN_EMAILS=
# Lets monitoring/autoscalers read GET /api/health/load with header x-ops-token.
OPS_TOKEN=
# Browser origins allowed to call the builder APIs (endpoint calls /api/run/* accept any origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Days the builder audit log keeps entries (changes and denied attempts per workspace).
AUDIT_RETENTION_DAYS=365

# --- Workspace databases -------------------------------------------------------------------------
# Server where ShipFlow creates each workspace's own database (sfb_<workspace>) for business data
# (shipments, warehouses, records). Default: the MONGO_URI server. Use a separate cluster if you like.
# BUSINESS_MONGO_URI=mongodb://localhost:27027
# Base64 32-byte key that encrypts connection strings of databases workspaces connect themselves.
# Required in production (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
DATA_ENCRYPTION_KEY=
# Allow connecting workspace databases on private/loopback addresses (local development only).
ALLOW_PRIVATE_DB_HOSTS=false
